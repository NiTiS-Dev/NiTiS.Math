<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>NiTiS.Math</AssemblyName>
		<Version>3.0.0</Version>

		<Description>The NiTiS library providing maths structs and operations for them.</Description>

		<PackageTags>NiTiS;Math;Vectors;Quaternion;Matrix;Vector;Matrixes;Physics;Generics</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>NiTiS.Math.Generics</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NiTiS.Core" Version="3.2.3" />
	</ItemGroup>
	
	<Import Project="../../Meta.props" />
</Project>